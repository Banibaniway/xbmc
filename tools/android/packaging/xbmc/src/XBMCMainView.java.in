package @APP_PACKAGE@;

import android.content.Context;
import android.graphics.PixelFormat;
import android.util.Log;
import android.view.SurfaceView;
import android.view.View;
import android.view.ViewGroup;
import android.view.Display;
import android.view.Window;
import android.view.WindowManager;
import android.os.Build;
import android.view.SurfaceHolder;

/**
 * Created by cbro on 5/13/17.
 */

public class XBMCMainView extends SurfaceView implements SurfaceHolder.Callback
{
  native void _attach();
  native void _surfaceChanged(SurfaceHolder holder, int format, int width, int height);
  native void _surfaceCreated(SurfaceHolder holder);
  native void _surfaceDestroyed(SurfaceHolder holder);

  private static final String TAG = "@APP_NAME@";

  public boolean mIsCreated = false;

  public XBMCMainView(Context context)
  {
    super(context);
    setZOrderOnTop(true);
    getHolder().addCallback(this);
    getHolder().setFormat(PixelFormat.TRANSPARENT);

    Log.d(TAG, "XBMCMainView: Created");
}

  private XBMCVideoView findVideoView()
  {
    try
    {
      ViewGroup vl = (ViewGroup) Main.MainActivity.findViewById(R.id.VideoLayout);
      if (vl == null)
        return null;
      for (int i = 0; i < vl.getChildCount(); i++)
      {
        View c = vl.getChildAt(i);
        if (c instanceof XBMCVideoView)
          return (XBMCVideoView) c;
      }
    }
    catch (Exception e)
    {
      Log.d(TAG, "XBMCMainView: findVideoView failed " + e);
    }
    return null;
  }

  /**
   * Diagnostic: force Android to rebuild layers.
   * 2: hide/show GUI view; 3: GUI alpha nudge; 4: hide/show video view;
   * 5: hide/show video and GUI views; 6: flip GUI z-order; 7: switch display mode away and back
   */
  public void refreshSurface(final int method)
  {
    post(new Runnable()
    {
      @Override
      public void run()
      {
        Log.d(TAG, "XBMCMainView: refreshSurface method " + method);
        final XBMCVideoView vv = (method == 4 || method == 5) ? findVideoView() : null;
        if (method == 2 || method == 5)
          setVisibility(View.INVISIBLE);
        if (vv != null)
          vv.setVisibility(View.INVISIBLE);
        if (method == 3)
          setAlpha(0.99f);
        if (method == 6)
        {
          setZOrderOnTop(false);
          requestLayout();
        }
        if (method == 7 && Build.VERSION.SDK_INT >= 23)
        {
          try
          {
            Window w = Main.MainActivity.getWindow();
            Display d = Main.MainActivity.getWindowManager().getDefaultDisplay();
            final int cur = d.getMode().getModeId();
            int other = -1;
            for (Display.Mode m : d.getSupportedModes())
              if (m.getModeId() != cur)
              {
                other = m.getModeId();
                break;
              }
            Log.d(TAG, "XBMCMainView: refreshSurface method 7: mode " + cur + " -> " + other + " -> " + cur);
            if (other > 0)
            {
              WindowManager.LayoutParams lp = w.getAttributes();
              lp.preferredDisplayModeId = other;
              w.setAttributes(lp);
              final Window fw = w;
              final int back = cur;
              postDelayed(new Runnable()
              {
                @Override
                public void run()
                {
                  WindowManager.LayoutParams lp2 = fw.getAttributes();
                  lp2.preferredDisplayModeId = back;
                  fw.setAttributes(lp2);
                }
              }, 2500);
            }
          }
          catch (Exception e)
          {
            Log.d(TAG, "XBMCMainView: method 7 failed " + e);
          }
        }
        postDelayed(new Runnable()
        {
          @Override
          public void run()
          {
            if (method == 2 || method == 5)
              setVisibility(View.VISIBLE);
            if (vv != null)
              vv.setVisibility(View.VISIBLE);
            if (method == 3)
              setAlpha(1.0f);
            if (method == 6)
            {
              setZOrderOnTop(true);
              requestLayout();
            }
          }
        }, 150);
      }
    });
  }

  @Override
  public void surfaceCreated(SurfaceHolder holder)
  {
    Log.d(TAG, "XBMCMainView: Surface Created");
    mIsCreated = true;
    _attach();
    _surfaceCreated(holder);
  }

  @Override
  public void surfaceChanged(SurfaceHolder holder, int format, int width, int height)
  {
    if (holder != getHolder())
      return;

    Log.d(TAG, "XBMCMainView: Surface Changed, format:" + format + ", width:" + width + ", height:" + height);
    _surfaceChanged(holder, format, width, height);
  }

  @Override
  public void surfaceDestroyed(SurfaceHolder holder)
  {
    Log.d(TAG, "XBMCMainView: Surface Destroyed");
    mIsCreated = false;
    _surfaceDestroyed(holder);
  }
}
